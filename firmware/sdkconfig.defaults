CONFIG_IDF_TARGET="esp32p4"

# This board's ESP32-P4 is chip revision v3.2 (esptool-reported), so the default (rev >= 3) applies.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n

# Flash / partitions
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM (32 MB)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# LVGL
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y
CONFIG_LV_USE_QRCODE=y
# LVGL allocates through malloc (PSRAM) instead of its small built-in pool
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# HTTPS to Home Assistant (if an https:// URL is used)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# Camera: OV02C10 (vendored driver in components/ov02c10), 1 lane 1288x728 RAW10
CONFIG_CAMERA_OV02C10=y
CONFIG_CAMERA_OV02C10_AUTO_DETECT=y
CONFIG_CAMERA_OV02C10_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV02C10_MIPI_RAW10_1288x728_30FPS=y
CONFIG_CAMERA_OV02C10_ISP_AF_ENABLE=n
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

# OTA with rollback: a new image must pass the boot hardware check
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.3.1"

# Web server: Basic auth header + several sockets
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=256

# Task watchdog also covers the thermostat task (added at runtime)
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_LV_USE_LABEL=y

# Console on the USB port (logs + the USB debug commands share the driver)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Wi-Fi co-processor (ESP32-C6) link: 20 MHz instead of 40 MHz. At 40 MHz the C6 stopped answering
# (SDIO tx failures) within minutes on the bench board; the thermostat needs little bandwidth.
CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=20000
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Code and rodata run from PSRAM: flash writes (OTA, history) no longer suspend the cache, so the display and
# the UI keep running (the screen flickered during OTA uploads).
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
